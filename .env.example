# PostgreSQL connection string (Neon in production)
DATABASE_URL=postgres://postgres@localhost:5432/portal

# Long random string used to sign verification links (openssl rand -hex 32)
APP_SECRET=change-me

# Public base URL used in emails and QR codes, without trailing slash
APP_URL=http://localhost:3000

# Root domain for JV subdomains, e.g. earldeign.co.zw (bullion.earldeign.co.zw -> Bullion JV)
ROOT_DOMAIN=earldeign.co.zw

# File storage: "blob" (Vercel Blob, needs BLOB_READ_WRITE_TOKEN) or "local" (disk, needs STORAGE_DIR)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
BLOB_READ_WRITE_TOKEN=

# Email (any SMTP provider). If SMTP_HOST is empty, emails are only written to the in-app outbox log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Earldeign Portal <noreply@earldeign.co.zw>"

# Seed users (first run only)
SEED_SUPER_ADMIN_EMAIL=tembanitich@outlook.com
SEED_CTO_EMAIL=tich@bulliongroup.co.zw
SEED_INITIAL_PASSWORD=
FUNCTIONAL_COLOURS=off

# Preview only: creates demo users for each role (never set in production)
PREVIEW_DEMO=off
DEMO_PASSWORD=
